# Local PostgreSQL connection used by the application during development.
DATABASE_URL="postgresql://leaf:leaf_dev_password@127.0.0.1:5433/leaf?schema=public"

# The local database does not need pooling; Prisma Migrate uses the same connection.
DIRECT_URL="postgresql://leaf:leaf_dev_password@127.0.0.1:5433/leaf?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# A unique password of at least 16 characters for the sole owner.
LEAF_OWNER_PASSWORD=""
